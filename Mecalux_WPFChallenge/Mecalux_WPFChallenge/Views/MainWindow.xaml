<Window x:Class="Mecalux_WPFChallenge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mecalux_WPFChallenge"
        xmlns:viewModels="clr-namespace:Mecalux_WPFChallenge.ViewModels"
        xmlns:views="clr-namespace:Mecalux_WPFChallenge.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AnalizarTextoViewModel}">
            <views:AnalizarTextoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OrdenarTextoViewModel}">
            <views:OrdenarTextoView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel Margin="15">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Content="Analizar" Command="{Binding AbrirAnalizarTextoCommand}" Margin="0,0,10,0" />
                <Button Content="Ordenar" Command="{Binding AbrirOrdenarTextoCommand}" Margin="0,0,10,0" />
            </StackPanel>
            <Border BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="5" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentViewModel}" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Window>
